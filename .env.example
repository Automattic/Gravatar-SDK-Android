# Sky Identity Check - Environment Configuration
# Copy to .env and customize for your environment

# ============================================================================
# ANALYTICS CONFIGURATION
# ============================================================================

# Enable Analytics (true/false)
# Set to false for local development (default)
# Set to true to enable Firestore integration
ENABLE_ANALYTICS=false

# Firebase Configuration (only needed if ENABLE_ANALYTICS=true)
FIRESTORE_PROJECT_ID=
# Format: your-gcp-project-id


# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================

# Gradio (Web UI)
GRADIO_PORT=7860
GRADIO_SHARE=false

# FastAPI (REST API)
API_PORT=8000
API_DEBUG=false

# Environment
ENVIRONMENT=development
# Options: development, staging, production


# ============================================================================
# OPTIONAL: SENTRY ERROR TRACKING
# ============================================================================

# Sentry DSN for error tracking (optional)
SENTRY_DSN=


# ============================================================================
# DEPLOYMENT NOTES
# ============================================================================

# Local Development:
#   cp .env.example .env
#   docker-compose up -d

# Hugging Face Spaces:
#   - Uses Dockerfile (port 7860 only)
#   - No environment variables needed

# Production (Cloud Run):
#   gcloud run deploy sky-identity-check \
#     --source . \
#     --set-env-vars ENABLE_ANALYTICS=true,FIRESTORE_PROJECT_ID=your-project
